# Copy this file to .env.local and fill in the values.

# Public site address (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.activonembroidery.com

# WhatsApp number in international format, digits only (e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles (leave blank to hide an icon)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXX) and Search Console verification token
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# SMTP for quote/contact emails. For Gmail: smtp.gmail.com, port 465, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=activonembroidery@gmail.com
SMTP_PASS=
# Where new inquiries are delivered
INQUIRY_TO=activonembroidery@gmail.com

# Inquiry dashboard login (/admin/)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-password
